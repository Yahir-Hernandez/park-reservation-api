# Copia este archivo a ".env" y ajusta los valores segun tu entorno.

# Cadena de conexion a PostgreSQL.
# Los valores por defecto coinciden con docker-compose.yml.
DATABASE_URL="postgresql://admin:adminpasword1234@localhost:5432/service_db?schema=public"

# Puerto en el que corre el servidor Express.
PORT=3000

# Secreto usado para firmar/verificar los JSON Web Tokens de autenticacion.
# OBLIGATORIO definir un valor propio y seguro en cualquier entorno real
# (el codigo trae un valor por defecto solo para no romper un primer arranque
# en desarrollo local).
JWT_SECRET="change-me-to-a-long-random-secret"

# Tiempo de expiracion de los JWT emitidos en /api/auth/login.
# Acepta el formato soportado por la libreria "jsonwebtoken" (ej. "1d", "12h", "3600").
JWT_EXPIRES_IN="1d"
